# Local Docker Database (mặc định nếu chạy độc lập cục bộ):
DATABASE_URL=postgresql://root:rootpassword@localhost:5433/online_judge_db?schema=public
RABBITMQ_URL=amqp://root:rootpassword@localhost:5672
REDIS_URL=redis://localhost:6379
PORT=3000
JWT_SECRET=super-secret-key-for-dev
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000
JUDGE_SECRET=default-judge-secret-key

# SMTP for forgot-password flow
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=test@gmail.com
SMTP_PASS=testpassword
SMTP_FROM=test@gmail.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# JWT_SECRET và JUDGE_SECRET là BẮT BUỘC (tối thiểu 16 ký tự); thiếu thì backend không khởi động.
# JUDGE_SECRET phải trùng với giá trị judge-runner dùng.

# Trợ lý AI (API tương thích OpenAI, ví dụ APIZ). Bỏ trống AI_API_KEY thì dùng câu trả lời soạn sẵn.
AI_BASE_URL=https://api.apiz.vn/v1
AI_API_KEY=
AI_MODEL_TUTOR=glm-5.3-flash
AI_MODEL_FALLBACK=claude-haiku-5-5
AI_DAILY_QUOTA=30
